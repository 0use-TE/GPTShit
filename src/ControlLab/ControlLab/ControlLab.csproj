<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><IsAotCompatible>true</IsAotCompatible>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets/Web/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Web/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../../firmware/*.py;../../../firmware/*.chip.json;../../../firmware/*.chip.wasm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Web/%(Filename)%(Extension)" />
    <Content Include="../../../firmware/runtime/*.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Web/runtime/%(Filename)%(Extension)" />
    <Content Include="../../../firmware/diagram.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Web/diagram.json" />
    <Content Include="../../../THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" />
    <Content Include="../../../firmware/runtime/MICROPYTHON-LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/MicroPython.txt" />
    <Content Include="../../../firmware/vendor/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/Wokwi-chip-api.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" /><PackageReference Include="Avalonia" />
    <PackageReference Include="Semi.Avalonia" /><PackageReference Include="GOZA.Dock" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Crystal.Avalonia" />
  </ItemGroup>
  <Target Name="BuildThermalFirmware" BeforeTargets="BeforeBuild"
          Inputs="../../../firmware/main.py;../../../firmware/pid.py;../../../tools/build_firmware.py"
          Outputs="../../../firmware/runtime/filesystem.bin">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../../../tools/build_firmware.py&quot;" />
  </Target>
</Project>



